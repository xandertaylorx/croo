{
  "name": "croo",
  "productName": "Croo",
  "version": "0.23.0",
  "description": "Croo: a minimal desktop AI coding agent with a frog in it. Bring your own API key.",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/fetch-engine.mjs && node scripts/build.mjs && node scripts/name-dev-electron.mjs && electron .",
    "start": "node scripts/name-dev-electron.mjs && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/make-icon.mjs",
    "engine": "node scripts/fetch-engine.mjs",
    "pack": "npm run engine && npm run build && electron-builder --dir",
    "dist": "npm run engine && npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "release": "npm run engine && npm run build && electron-builder --mac --publish always"
  },
  "keywords": [
    "ai",
    "agent",
    "desktop",
    "electron",
    "coding",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "ollama"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xandertaylorx/croo.git"
  },
  "license": "MIT",
  "author": "Xander Taylor",
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@types/node": "^22.20.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "dev.croo.app",
    "productName": "Croo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon*.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/llama",
        "to": "llama"
      },
      {
        "from": "vendor/whisper",
        "to": "whisper"
      },
      {
        "from": "vendor/rg",
        "to": "rg"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Croo uses the microphone only when you press the mic button to dictate a message."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "xandertaylorx",
        "repo": "croo",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
